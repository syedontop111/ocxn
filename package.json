@tailwind base;
@tailwind components;
@tailwind utilities;

/* ─── CSS VARIABLES ─────────────────────────────────────────────────────────── */
@layer base {
  :root {
    --radius: 0.75rem;
    --background: #fafafa;
    --foreground: #18181b;
    --card: #ffffff;
    --card-foreground: #18181b;
    --popover: #ffffff;
    --popover-foreground: #18181b;
    --primary: #6d28d9;
    --primary-foreground: #fafafa;
    --secondary: #f4f4f5;
    --secondary-foreground: #18181b;
    --muted: #f4f4f5;
    --muted-foreground: #71717a;
    --accent: #f4f4f5;
    --accent-foreground: #18181b;
    --destructive: #ef4444;
    --destructive-foreground: #fafafa;
    --border: #e4e4e7;
    --input: #e4e4e7;
    --ring: #6d28d9;
    --sidebar: #ffffff;
    --sidebar-foreground: #18181b;
    --sidebar-primary: #6d28d9;
    --sidebar-primary-foreground: #fafafa;
    --sidebar-accent: #f4f4f5;
    --sidebar-accent-foreground: #18181b;
    --sidebar-border: #e4e4e7;
    --sidebar-ring: #6d28d9;
  }

  .dark {
    --background: #09090b;
    --foreground: #fafafa;
    --card: #09090b;
    --card-foreground: #fafafa;
    --popover: #09090b;
    --popover-foreground: #fafafa;
    --primary: #a78bfa;
    --primary-foreground: #09090b;
    --secondary: #27272a;
    --secondary-foreground: #fafafa;
    --muted: #27272a;
    --muted-foreground: #a1a1aa;
    --accent: #27272a;
    --accent-foreground: #fafafa;
    --destructive: #7f1d1d;
    --destructive-foreground: #fafafa;
    --border: #27272a;
    --input: #27272a;
    --ring: #a78bfa;
    --sidebar: #09090b;
    --sidebar-foreground: #fafafa;
    --sidebar-primary: #a78bfa;
    --sidebar-primary-foreground: #09090b;
    --sidebar-accent: #27272a;
    --sidebar-accent-foreground: #fafafa;
    --sidebar-border: #27272a;
    --sidebar-ring: #a78bfa;
  }

  * {
    border-color: var(--border);
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  *::-webkit-scrollbar { width: 6px; height: 6px; }
  *::-webkit-scrollbar-track { background: transparent; }
  *::-webkit-scrollbar-thumb { background-color: var(--border); border-radius: 9999px; }
  *::-webkit-scrollbar-thumb:hover { background-color: var(--muted-foreground); }

  body {
    background-color: var(--background);
    color: var(--foreground);
    font-family: "Inter", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
}

/* ─── UTILITY CLASSES ───────────────────────────────────────────────────────── */
@layer utilities {
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  .logo-gradient {
    background: linear-gradient(135deg, #7c3aed, #a855f7, #6366f1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .glow-btn {
    box-shadow: 0 0 20px rgba(109, 40, 217, 0.35);
  }
  .dark .glow-btn {
    box-shadow: 0 0 20px rgba(167, 139, 250, 0.35);
  }

  .float-anim {
    animation: float 3s ease-in-out infinite;
  }

  .typing-cursor::after {
    content: "▋";
    display: inline-block;
    vertical-align: bottom;
    animation: caret-blink 1s step-end infinite;
    color: var(--primary);
    font-size: 0.8em;
    margin-left: 2px;
  }

  .thinking-dot:nth-child(1) { animation: pulse-dot 1.2s infinite 0s; }
  .thinking-dot:nth-child(2) { animation: pulse-dot 1.2s infinite 0.2s; }
  .thinking-dot:nth-child(3) { animation: pulse-dot 1.2s infinite 0.4s; }

  .animate-in { animation: slide-in 0.3s ease forwards; }
  .fade-in    { animation: fade-in 0.5s ease forwards; }
}

/* ─── AI PROSE ──────────────────────────────────────────────────────────────── */
.ai-prose h1, .ai-prose h2, .ai-prose h3 {
  font-weight: 600;
  margin: 0.75rem 0 0.4rem;
  line-height: 1.3;
}
.ai-prose h1 { font-size: 1.2em; }
.ai-prose h2 { font-size: 1.1em; }
.ai-prose h3 { font-size: 1em; }
.ai-prose p  { margin: 0.4rem 0; line-height: 1.7; }
.ai-prose ul, .ai-prose ol { padding-left: 1.4rem; margin: 0.4rem 0; }
.ai-prose li { margin: 0.2rem 0; line-height: 1.6; }
.ai-prose strong { font-weight: 600; }
.ai-prose a { color: var(--primary); text-decoration: underline; }
.ai-prose blockquote {
  border-left: 3px solid var(--primary);
  padding-left: 0.8rem;
  margin: 0.5rem 0;
  color: var(--muted-foreground);
  font-style: italic;
}
.ai-prose table { width: 100%; border-collapse: collapse; margin: 0.5rem 0; font-size: 0.9em; }
.ai-prose th, .ai-prose td { border: 1px solid var(--border); padding: 0.4rem 0.7rem; text-align: left; }
.ai-prose th { background: var(--muted); font-weight: 600; }
.ai-prose hr { border: none; border-top: 1px solid var(--border); margin: 0.8rem 0; }

/* ─── CODE BLOCKS ───────────────────────────────────────────────────────────── */
pre {
  background: var(--muted);
  border-radius: 0.5rem;
  padding: 1rem;
  overflow-x: auto;
  margin: 0.5rem 0;
  border: 1px solid var(--border);
}
code {
  font-family: "Fira Code", "Courier New", monospace;
  font-size: 0.85em;
}
pre code { background: none; padding: 0; }
:not(pre) > code {
  background: var(--muted);
  padding: 0.15em 0.4em;
  border-radius: 0.25rem;
  border: 1px solid var(--border);
}

/* ─── KEYFRAMES ─────────────────────────────────────────────────────────────── */
@keyframes caret-blink {
  0%, 70%, 100% { opacity: 1; }
  20%, 50%      { opacity: 0; }
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-8px); }
}
@keyframes pulse-dot {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.3; }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes slide-in {
  from { transform: translateY(8px); opacity: 0; }
  to   { transform: translateY(0);   opacity: 1; }
}
